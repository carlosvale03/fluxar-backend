# Django Core
SECRET_KEY=sua-chave-secreta-aqui
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=fluxar_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Configurações de E-mail (Resend Principal, Brevo Fallback)
RESEND_API_KEY=re_suachaveresend_aqui
ENABLE_RESEND_PROVIDER=True

# Fallback SMTP (Brevo)
EMAIL_HOST=smtp-relay.sendinblue.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email-verificado-no-brevo@exemplo.com
EMAIL_HOST_PASSWORD=sua-chave-smtp-do-brevo
DEFAULT_FROM_EMAIL=Fluxar <seu-email-verificado-no-brevo@exemplo.com>
ENABLE_SMTP_FALLBACK=True

# Fallback 2 (apenas para testes): EmailJS REST API
USE_EMAILJS_TESTING_FALLBACK=False
EMAIL_DEBUG_LOGS=True
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxxx
